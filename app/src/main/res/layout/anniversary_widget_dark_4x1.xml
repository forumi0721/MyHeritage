<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/anniversary_widget_dark_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp">

    <!-- [1st] 첫 번째 기념일 영역 (크게) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- D-Day 뱃지 -->
        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:background="@drawable/anniversary_widget_dark_badge_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/widget_dday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D-Day"
                android:textColor="#FF8A80"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 정보 텍스트 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가장 가까운 기념일"
                android:textColor="#E0E0E0"
                android:textStyle="bold"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로딩 중..."
                android:textColor="#B0BEC5"
                android:textSize="10sp"
                android:layout_marginTop="1dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 세로 구분선 (Divider) -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#455A64"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp" />

    <!-- [2nd] 두 번째 기념일 영역 (그 다음 - 작게) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="start">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_next_dday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[D-일]"
                android:textColor="#FFB74D"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="그 다음 기념일"
                android:textColor="#CFD8DC"
                android:textStyle="bold"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="대기 일정 없음"
            android:textColor="#90A4AE"
            android:textSize="9sp"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
