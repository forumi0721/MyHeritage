<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/anniversary_widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- [1st] 첫 번째 기념일 영역 (메인 - 크게) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.65"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- D-Day 뱃지 카지노 카드 스스타일 -->
        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_dday_badge_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/widget_dday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D-Day"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 정보 텍스트 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가장 가까운 기념일"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로딩 중..."
                android:textColor="#3F51B5"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 세로 구분선 (Divider) -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#BBDEFB"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp" />

    <!-- [2nd] 두 번째 기념일 영역 (그 다음 - 서브) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_next_dday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[D-일]"
                android:textColor="#E65100"
                android:textStyle="bold"
                android:textSize="11sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 다음 일정"
                android:textColor="#37474F"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginStart="2dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="날짜"
            android:textColor="#78909C"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
